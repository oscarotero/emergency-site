<!DOCTYPE html>
<html class="no-js" lang="{{ lang }}">
    <head>
        <meta charset="utf-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="alternate" href="/feed.xml" type="application/atom+xml" title="{{ metas.site }}">
        <link rel="alternate" href="/feed.json" type="application/json" title="{{ metas.site }}">
        <title>{{ if title -}}{{ title }} | {{ metas.site }}{{- else -}}{{ metas.site }}{{ /if }}</title>
        <link rel="stylesheet" href="/style.css" inline>

        {{ if metas.color }}
        <style>
        :root {
            --brand-color: {{ metas.color }};
        }
        </style>
        {{ /if }}
    </head>
    <body class="site">
        {{ include "notification.vto" }}

        {{ include "header.vto" }}
        <main class="main">{{ content }}</main>
        {{ include "footer.vto" }}

        {{ if env === "production" }}
        <script src="/static/scripts/offline.js" async defer></script>
        {{ /if }}
    </body>
</html>
