<ol class="postlist" reversed>
{{ for post of search.pages("type=posts", "date=desc") }}
    <li>
        <a href="{{ post.url }}">{{ post.title }}</a>
        <time datetime="{{ post.date |> date('DATETIME') }}">
            ({{ post.date |> date("HUMAN_DATE") }})
        </time>
    </li>
{{ /for }}
</ol>
